<Project Sdk="Microsoft.NET.Sdk">

  <!-- CLT Agent for macOS: connects to AMS via SignalR, reports the computer, launches the desktop
       process when IT opens a session. Runs as a launchd daemon (/Library/LaunchDaemons).
       Build: dotnet publish -c Release -r osx-arm64 (or osx-x64); single file, self-contained. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AMS.RemoteMac.Agent</RootNamespace>
    <AssemblyName>CLT-Agent</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" />
  </ItemGroup>

</Project>
