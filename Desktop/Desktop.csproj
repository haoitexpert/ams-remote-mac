<Project Sdk="Microsoft.NET.Sdk">

  <!-- CLT Desktop for macOS: screen capture (CoreGraphics) + input relay (CGEvent) + SignalR to /remote/hubs/desktop.
       Launched by the agent when IT starts a session; runs as the signed-in user, in that user's GUI session.
       Build: dotnet publish -c Release -r osx-arm64 (or osx-x64); single file, self-contained. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AMS.RemoteMac.Desktop</RootNamespace>
    <AssemblyName>CLT-Desktop</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" />
  </ItemGroup>

</Project>
