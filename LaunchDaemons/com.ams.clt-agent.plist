<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon: the CLT agent runs at boot as root, connects to AMS, stays connected.
     Installed to /Library/LaunchDaemons/com.ams.clt-agent.plist by Installer/install.sh.
     Start: sudo launchctl bootstrap system /Library/LaunchDaemons/com.ams.clt-agent.plist
     Stop:  sudo launchctl bootout system/com.ams.clt-agent -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ams.clt-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/lib/CLT/CLT-Agent</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/usr/local/lib/CLT</string>

    <key>StandardOutPath</key>
    <string>/var/log/clt-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/clt-agent.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
